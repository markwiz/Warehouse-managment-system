# Copy to .env and adjust. Shared by backend, frontend (VITE_* only) and docker-compose.

# --- App ---
ENVIRONMENT=development
DEBUG=true
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL ---
POSTGRES_USER=wms
POSTGRES_PASSWORD=wms
POSTGRES_DB=wms
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://wms:wms@localhost:5432/wms
# Separate database for pytest (created automatically if missing)
TEST_DATABASE_URL=postgresql+psycopg://wms:wms@localhost:5432/wms_test

# --- LLM (LangChain / LangGraph) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Frontend ---
VITE_API_PROXY_TARGET=http://localhost:8000
